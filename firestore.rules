rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net default catch-all - Deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Rules for user settings and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && incoming().bikeName is string && incoming().bikeName.size() <= 100
                    && incoming().bikeModel is string && incoming().bikeModel.size() <= 100
                    && incoming().currentOdo is int && incoming().currentOdo >= 0;
      allow update: if isOwner(userId)
                    && (incoming().bikeName is string && incoming().bikeName.size() <= 100)
                    && (incoming().bikeModel is string && incoming().bikeModel.size() <= 100)
                    && (incoming().currentOdo is int && incoming().currentOdo >= 0);
      allow delete: if isOwner(userId);

      // Subcollection: fuelLogs
      match /fuelLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: maintenanceEvents
      match /maintenanceEvents/{eventId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: documents
      match /documents/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: garageMods
      match /garageMods/{modId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: miscExpenses
      match /miscExpenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
